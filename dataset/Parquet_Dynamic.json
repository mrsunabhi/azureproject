{
	"name": "Parquet_Dynamic",
	"properties": {
		"linkedServiceName": {
			"referenceName": "DataLake",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"pcontainer": {
				"type": "string"
			},
			"pfolder": {
				"type": "string"
			},
			"pfile": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Parquet",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().pfile",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@dataset().pfolder",
					"type": "Expression"
				},
				"fileSystem": {
					"value": "@dataset().pcontainer",
					"type": "Expression"
				}
			},
			"compressionCodec": "snappy"
		},
		"schema": []
	}
}